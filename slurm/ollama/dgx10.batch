#!/bin/bash
#SBATCH --partition interactive
#SBATCH --nodes 1
#SBATCH --ntasks-per-node 1
#SBATCH --mem-per-cpu 128G
#SBATCH --gres gpu:1
#SBATCH --time 72:00:00
#SBATCH --job-name jupyter
#SBATCH --output /home/stulcrad/master_thesis/logs/ollama/ollama.out
unset LMOD_ROOT
unset MODULESHOME
unset LMOD_PKG
unset LMOD_CMD
unset LMOD_DIR
unset FPATH
unset __LMOD_REF_COUNT_MODULEPATH
unset __LMOD_REF_COUNT__LMFILES_
unset _LMFILES_
unset _ModuleTable001_
unset _ModuleTable002_
source /etc/profile.d/lmod.sh

export OLLAMA_HOST=0.0.0.0:9069
echo "OLLAMA_HOST=${OLLAMA_HOST}"

cd ~/master_thesis
source init_environment_python.sh

ollama serve
