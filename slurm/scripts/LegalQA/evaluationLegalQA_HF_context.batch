#!/bin/bash
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:2
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --job-name=LegalQA_HF_context_eval
#SBATCH --output=/home/stulcrad/master_thesis/logs/scripts/evaluationLegalQA_HF_context_%j.out
#SBATCH --error=/home/stulcrad/master_thesis/logs/scripts/evaluationLegalQA_HF_context_%j.err

cd ~/master_thesis
source init_environment_python.sh


echo "Starting NER Context Based HF evaluation on node $(hostname -s)"

python scripts/LegalQA/evaluationLegalQA_HF_context.py
