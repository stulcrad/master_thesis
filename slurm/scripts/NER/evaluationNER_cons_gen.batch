#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --mem=96G
#SBATCH --cpus-per-task=32
#SBATCH --job-name=ner_uner_cg_eval
#SBATCH --output=/home/stulcrad/master_thesis/logs/scripts/out/ner/%x_%N_%a_%A.out
#SBATCH --error=/home/stulcrad/master_thesis/logs/scripts/err/ner/%x_%N_%a_%A.err

cd ~/master_thesis
source init_environment_python.sh

echo "Starting Constrained Generation evaluation on node $(hostname -s)"

MODEL_NAME=$(python -m utils.model_registry --id "$SLURM_ARRAY_TASK_ID") || exit 1

SHARDS="${SHARDS:-1}"
NGPU="${SLURM_GPUS_ON_NODE:-$(nvidia-smi -L 2>/dev/null | wc -l)}"
# ":-1" only catches UNSET/empty. `nvidia-smi | wc -l` on a node without it returns
# the string "0", which survives that and makes `i % NGPU` a division by zero.
[ "${NGPU:-0}" -gt 0 ] || NGPU=1

# Which dataset this job is running decides HOW the work is split:
#   conll2003 -> by example index   (--shard i/N)
#   uner      -> by treebank group  (--subset a b c), greedy bin-packed on size, and split into 
#                --chunk i/N windows for each job.
DATASET=""; _prev=""
for _a in "$@"; do [ "$_prev" = "--dataset" ] && DATASET="$_a"; _prev="$_a"; done

if [ "$SHARDS" -le 1 ]; then
    export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-1}"
    echo "Running unsharded (1 process), dataset=$DATASET"
    python scripts/NER/evaluationNER_cons_gen.py --model "$MODEL_NAME" "$@"
else
    # One entry per process: the extra argument(s) selecting that process's slice.
    # Both forms are plain strings, so a single launch loop covers both datasets.
    SPLIT_ARGS=()
    if [ "$DATASET" = "uner" ]; then
        # UNER_CHUNK ("i/N") is set by the submitter when an arm is split over
        # several jobs. The packing itself is global: bin_packing packs into
        # N*SHARDS groups once and returns only this job's window, so the split
        # is balanced across the whole arm rather than within each job, allowing for
        # more jobs to be used without unbalancing the work.
        mapfile -t SPLIT_ARGS < <(python -m utils.bin_packing uner "$SHARDS" \
                                  ${UNER_CHUNK:+--chunk "$UNER_CHUNK"} "$@")
        if [ "${#SPLIT_ARGS[@]}" -eq 0 ]; then
            echo "No treebanks fall in chunk ${UNER_CHUNK:-0/1} at SHARDS=$SHARDS -- nothing to do."
            exit 0
        fi
    else
        for i in $(seq 0 $((SHARDS - 1))); do
            SPLIT_ARGS+=("--shard $i/$SHARDS")
        done
    fi

    # bin_packing can return FEWER groups than SHARDS (more shards than treebanks),
    # so size the thread split and the loop off the real process count.
    NPROC="${#SPLIT_ARGS[@]}"
    export OMP_NUM_THREADS=$(( ${SLURM_CPUS_PER_TASK:-1} / NPROC ))
    [ "$OMP_NUM_THREADS" -lt 1 ] && OMP_NUM_THREADS=1

    echo "Running $NPROC processes across $NGPU GPU(s), dataset=$DATASET"
    pids=()
    for i in "${!SPLIT_ARGS[@]}"; do
        echo "  process $i -> GPU $(( i % NGPU )) : ${SPLIT_ARGS[$i]}"
        # ${SPLIT_ARGS[$i]} is deliberately UNQUOTED so it word-splits back into
        # separate argv entries. It goes AFTER "$@": for UNER that makes argparse
        # take this group over any earlier --subset (last occurrence wins).
        CUDA_VISIBLE_DEVICES=$(( i % NGPU )) \
            python scripts/NER/evaluationNER_cons_gen.py --model "$MODEL_NAME" \
                   "$@" ${SPLIT_ARGS[$i]} &
        pids+=($!)
        sleep 20   # stagger the checkpoint loads, host RAM spikes otherwise
    done
    rc=0
    # wait per PID: a bare `wait` returns 0 even when a child failed, which would
    # mark the job COMPLETED with one process's results missing.
    for p in "${pids[@]}"; do
        wait "$p" || rc=$?
    done
    exit $rc
fi
