#!/bin/bash
#SBATCH --partition=amdgpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:2
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --job-name=ToxicSpans_HF_context_eval
#SBATCH --output=/home/stulcrad/master_thesis/logs/scripts/evaluationToxicSpans_HF_context%j.out
#SBATCH --error=/home/stulcrad/master_thesis/logs/scripts/evaluationToxicSpans_HF_context%j.err

cd ~/master_thesis
source init_environment_python.sh


echo "Starting Context Based HF evaluation on node $(hostname -s)"

python scripts/ToxicSpans/evaluationToxicSpans_HF_context.py
