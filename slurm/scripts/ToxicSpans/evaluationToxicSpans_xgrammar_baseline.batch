#!/bin/bash
#SBATCH --partition=amdgpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --job-name=ToxicSpans_xgrammar_baseline_eval
#SBATCH --output=/home/stulcrad/master_thesis/logs/scripts/evaluationToxicSpans_xgrammar_baseline_%j.out
#SBATCH --error=/home/stulcrad/master_thesis/logs/scripts/evaluationToxicSpans_xgrammar_baseline_%j.err

cd ~/master_thesis
source init_environment_python.sh


echo "Starting ToxicSpans XGrammar Context Based Baseline evaluation on node $(hostname -s)"

python scripts/ToxicSpans/evaluationToxicSpans_xgrammar_baseline.py
